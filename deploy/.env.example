# docker-compose.yml reads this file from the deploy directory.
SANDBOX_TOKEN=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
ALLOW_REGISTER=true
COOKIE_SECURE=auto

# Select distinct logical CPU numbers on the production judge host.
# JUDGE_CPUSET=2,3,4,5
JUDGE_WORKERS=2

RERUN_BORDERLINE=true
MAX_CODE_BYTES=65536
ARGON_MEMORY_KB=19456
ARGON_ITERATIONS=2
ARGON_PARALLELISM=1

OJ_BIND=127.0.0.1
PORT=8080
JUDGE_SHM_SIZE=512m
GO_JUDGE_IMAGE=criyle/go-judge:latest
GO_IMAGE=golang:1.23-bookworm

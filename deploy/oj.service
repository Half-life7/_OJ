[Unit]
Description=OJ web and judge coordinator
Wants=network-online.target go-judge.service
After=network-online.target go-judge.service

[Service]
Type=simple
User=oj
Group=oj
WorkingDirectory=/opt/oj
EnvironmentFile=/etc/oj/oj.env
ExecStart=/opt/oj/oj
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
StateDirectory=oj
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/var/lib/oj

[Install]
WantedBy=multi-user.target

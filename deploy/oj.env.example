PORT=8080
DB_PATH=/var/lib/oj/oj.db
LANGUAGES_FILE=/opt/oj/languages.yaml
SANDBOX=gojudge
SANDBOX_URL=http://127.0.0.1:5050
SANDBOX_TOKEN=replace-with-the-same-token-as-go-judge.env
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
ALLOW_REGISTER=true
COOKIE_SECURE=auto
TRUSTED_PROXY=
JUDGE_WORKERS=2
JUDGE_CPUSET=
RERUN_BORDERLINE=true
MAX_CODE_BYTES=65536
ARGON_MEMORY_KB=19456
ARGON_ITERATIONS=2
ARGON_PARALLELISM=1

ARG DEBIAN_IMAGE=debian:bookworm-slim
ARG GO_IMAGE=${DEBIAN_IMAGE}
FROM ${GO_IMAGE} AS build
ARG GOPROXY=https://proxy.golang.org,direct
ARG DEBIAN_MIRROR_BASE
ARG GO_TOOLCHAIN_URL=https://go.dev/dl
COPY deploy/install-debian-packages.sh deploy/install-go-toolchain.sh /tmp/
RUN if ! command -v go >/dev/null; then \
        sh /tmp/install-debian-packages.sh ca-certificates curl && sh /tmp/install-go-toolchain.sh; \
    fi
ENV PATH="/usr/local/go/bin:${PATH}"
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/oj ./cmd/oj

FROM ${DEBIAN_IMAGE}
ARG DEBIAN_MIRROR_BASE
COPY deploy/install-debian-packages.sh /tmp/install-debian-packages.sh
RUN sh /tmp/install-debian-packages.sh ca-certificates curl \
    && rm /tmp/install-debian-packages.sh \
    && groupadd --gid 10001 oj && useradd --uid 10001 --gid oj --no-create-home oj \
    && install -d -o oj -g oj /var/lib/oj
WORKDIR /app
COPY --from=build /out/oj /app/oj
COPY languages.yaml /app/languages.yaml
ENV PORT=8080 DB_PATH=/var/lib/oj/oj.db LANGUAGES_FILE=/app/languages.yaml
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/app/oj"]
